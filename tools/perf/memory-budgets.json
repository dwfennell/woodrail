    },
    "count": {
      "about": "objects: max = measured x (1 + margin), at least measured + floor (three runs moved by 0.7% at most)",
      "margin": 0.05,
      "floor": 2
    },
    "leakMB": {
      "about": "growth over the rebuild cycles (MB): max = measured + absolute (three runs moved by 0.1 MB)",
      "absolute": 1
    },
    "leakCount": {
