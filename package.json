{
  "name": "woodrail",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "bench": "vite build --config bench/vite.config.ts --logLevel warn && node dist-bench/track.js",
    "catalogue": "vite --config catalogue/vite.config.ts",
    "catalogue:build": "vite build --config catalogue/vite.config.ts",
    "models": "${BLENDER_PYTHON:-python3} tools/blender/trains.py && ${BLENDER_PYTHON:-python3} tools/blender/life.py && mkdir -p public/models && gltfpack -i tools/blender/out/trains.glb -o public/models/trains.glb -cc -kn -km -vtf && gltfpack -i tools/blender/out/life.glb -o public/models/life.glb -cc -kn -km -vtf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwfennell/woodrail.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dwfennell/woodrail/issues"
  },
  "homepage": "https://github.com/dwfennell/woodrail#readme",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/three": "^0.186.0",
    "gltfpack": "^1.3.0",
    "tinybench": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.5"
  }
}
