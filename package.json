{
  "name": "woodrail",
  "version": "1.0.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/icon-font.py",
    "perf": "node tools/perf/run.mjs",
    "perf:check": "node tools/perf/check.mjs",
    "bench": "vite build --config bench/vite.config.ts --logLevel warn && node dist-bench/track.js",
    "catalogue": "vite --config catalogue/vite.config.ts",
    "catalogue:build": "vite build --config catalogue/vite.config.ts",
    "models": "${BLENDER_PYTHON:-python3} tools/blender/trains.py && ${BLENDER_PYTHON:-python3} tools/blender/life.py && ${BLENDER_PYTHON:-python3} tools/blender/bldg.py && ${BLENDER_PYTHON:-python3} tools/blender/dressing.py && SET=industry ${BLENDER_PYTHON:-python3} tools/blender/dressing.py && ${BLENDER_PYTHON:-python3} tools/blender/floors.py && mkdir -p public/models && gltfpack -i tools/blender/out/trains.glb -o public/models/trains.glb -cc -kn -km && gltfpack -i tools/blender/out/life.glb -o public/models/life.glb -cc -kn -km && gltfpack -i tools/blender/out/buildings.glb -o public/models/buildings.glb -cc -kn -km && gltfpack -i tools/blender/out/dressing.glb -o public/models/dressing.glb -cc -kn -km && gltfpack -i tools/blender/out/industry.glb -o public/models/industry.glb -cc -kn -km && gltfpack -i tools/blender/out/floors.glb -o public/models/floors.glb -cc -kn -km",
    "fuzz:long": "node scripts/fuzz-long.mjs",
    "balance:sweep": "node scripts/balance-sweep.mjs",
    "replay": "node scripts/replay.mjs",
    "feedback": "node scripts/fetch-feedback.mjs",
    "e2e:roads": "node scripts/e2e/roads.mjs",
    "e2e:draw": "node scripts/e2e/draw.mjs",
    "e2e:touch": "node scripts/e2e/touch.mjs",
    "e2e:affected": "node scripts/e2e/affected.mjs",
    "e2e:click": "node scripts/e2e/click-place.mjs",
    "e2e:names": "node scripts/e2e/lib/run.mjs scripts/e2e/piece-names.mjs",
    "e2e:cloud": "node scripts/e2e/cloud.mjs",
    "e2e:tutorial": "node scripts/e2e/lib/run.mjs scripts/e2e/tutorial.mjs",
    "e2e:joints": "node scripts/e2e/lib/run.mjs scripts/e2e/joints.mjs",
    "e2e:ramps": "node scripts/e2e/lib/run.mjs scripts/e2e/ramps.mjs",
    "e2e:low-bridge": "node scripts/e2e/lib/run.mjs tools/e2e/low-bridge.mjs",
    "e2e:tunnels": "node scripts/e2e/lib/run.mjs tools/e2e/tunnels.mjs",
    "e2e:tray": "npm run build && node scripts/e2e/lib/run.mjs scripts/e2e/tray.mjs",
    "e2e:decks": "node scripts/e2e/lib/run.mjs tools/e2e/deck-taps.mjs",
    "e2e:kits": "node scripts/e2e/lib/run.mjs tools/e2e/track-props.mjs",
    "e2e:kits-game": "node scripts/e2e/lib/run.mjs tools/e2e/kits-game.mjs",
