    "e2e:landscaping": "node scripts/e2e/lib/run.mjs tools/e2e/landscaping.mjs",
    "e2e:station-upgrade": "node scripts/e2e/lib/run.mjs tools/e2e/station-upgrade.mjs",
    "e2e:station-touches": "node scripts/e2e/lib/run.mjs tools/e2e/station-touches.mjs",
    "e2e:lift": "node scripts/e2e/lib/run.mjs tools/e2e/lift.mjs",
    "e2e:loop": "node scripts/e2e/lib/run.mjs tools/e2e/kit-loop.mjs",
    "e2e:research": "node scripts/e2e/lib/run.mjs tools/e2e/research-picker.mjs",
    "e2e:growth": "node scripts/e2e/lib/run.mjs tools/e2e/growth-menu.mjs",
    "e2e:copy-map": "node scripts/e2e/lib/run.mjs tools/e2e/copy-map.mjs",
