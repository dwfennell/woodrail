    "e2e:engine-names": "node scripts/e2e/lib/run.mjs tools/e2e/engine-names.mjs",
    "e2e:stickers": "node scripts/e2e/lib/run.mjs tools/e2e/stickers.mjs",
    "e2e:stats": "node scripts/e2e/lib/run.mjs tools/e2e/stats.mjs",
    "e2e:workshop": "node scripts/e2e/lib/run.mjs tools/e2e/workshop-modes.mjs",
    "e2e:warehouse": "node scripts/e2e/lib/run.mjs tools/e2e/warehouse.mjs",
    "e2e:focus-ring": "node scripts/e2e/lib/run.mjs tools/e2e/focus-ring.mjs",
    "e2e:hopper-load": "node scripts/e2e/lib/run.mjs tools/e2e/hopper-load.mjs",
    "e2e:locked": "node scripts/e2e/lib/run.mjs tools/e2e/locked-tiles.mjs",
    "e2e:signals": "node scripts/e2e/lib/run.mjs tools/e2e/signals.mjs",
    "e2e:sandbox-chains": "node scripts/e2e/lib/run.mjs tools/e2e/sandbox-chains.mjs",
    "e2e:life": "node scripts/e2e/lib/run.mjs tools/e2e/life.mjs",
    "build:artifact": "node scripts/artifact-build.mjs",
    "build:itch": "node scripts/itch-build.mjs",
    "blueprints:page": "node scripts/blueprint-page.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwfennell/woodrail.git"
