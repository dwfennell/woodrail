+  /**
+   * Holding never blocks loading: what this car's train loads into it on the way to the school set to Research first,
+   * if anything, so the `kind` it carries isn't held for that school (it's dropped here, where it's wanted, instead).
+   * The 2026-11-01 release QA: planks held for the school rode round the line in the timber wagons, so at the forest
+   * they took no logs, nothing was sawn and a city went 70 minutes without planks (balance seed 5). Null: nothing
+   * loads into it first. A routed train: the pickup stops before the school (`Later.loads`); a hand-run one: the
+   * depots it comes to before the school, the points as they lie (`reachOf`, in the order it comes to them).
+   */
+  private loadsFirst(carId: number, kind: CargoKind, route: Route | null): CargoKind | null {
+    const found = this.sim.findCar(carId);
+    if (!found) return null;
+    const car = found.train.cars[found.index].kind;
+    let fits = 0;
+    for (const k of CARGO_KINDS) if (k !== kind && canCarry(car, k)) fits |= 1 << CARGO[k].index;
+    if (fits === 0) return null;
+    let loads = 0;
+    if (route) loads = this.laterOf(route.stops, route.next % route.stops.length).loads & fits;
+    else {
+      for (const pieceId of this.reachOf(found.train)) {
+        const d = this.byPiece.get(pieceId);
+        if (!d || !d.auto) continue;
+        if (d.role === "school" && d.takesAll && (!this.accepts || this.accepts(d, kind))) break;
+        if (RECIPES[d.role].routedOnly) continue;
+        for (const k of RECIPES[d.role].gives) loads |= (1 << CARGO[k].index) & fits;
+        if (loads) break;
+      }
+    }
+    if (loads === 0) return null;
+    return CARGO_KINDS.find((k) => loads & (1 << CARGO[k].index)) ?? null;
+  }
+
+  /**
+   * A train beside a town or a workshop dropping goods a school set to Research first lacks, because it loads the wagon
+   * they're in on the way there (`loadsFirst`): the goods, the load and the depot, for its engine card. Null: none.
+   * Asked only while its card is open.
+   */
+  droppedForLoading(trainId: number): { depot: DepotState; kind: CargoKind; load: CargoKind } | null {
+    const train = this.sim.getTrain(trainId);
+    if (!train) return null;
+    const route = this.routeOfTrain(train);
+    for (const b of train.bogies) {
+      const d = this.byPiece.get(b.pieceId);
+      if (!d || !d.auto || (d.role !== "town" && d.role !== "workshop")) continue;
+      for (const car of train.cars) {
+        const c = this.cargo.get(car.id);
+        if (!c?.kind || c.count <= 0 || (this.sinkWants?.(c.kind) ?? 0) <= 0 || this.keepWhy(d, car.id) !== null) continue;
+        if (route ? !(this.laterOf(route.stops, route.next % route.stops.length).school & (1 << CARGO[c.kind].index)) : !this.schools.some((s) => s.takesAll)) continue;
+        const load = this.loadsFirst(car.id, c.kind, route);
+        if (load) return { depot: d, kind: c.kind, load };
+      }
+    }
+    return null;
   }
   private schools: DepotState[] = [];
   private schoolsOf: readonly DepotState[] | null = null;
