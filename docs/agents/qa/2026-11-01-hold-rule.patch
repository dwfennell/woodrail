+describe("holding never blocks loading: nothing is kept for the school in wagons the train loads on the way there", () => {
+  // (The 2026-11-01 release QA, balance seed 5: planks kept for a Research-first school rode round the line in the
+  // timber wagons, so at the forest they took no logs, nothing was sawn and a city went 70 minutes without planks.)
+  it("a hand-run train coming to the forest before the school drops its planks at the town, and its card says why", () => {
+    const p = lackingPlanks();
+    const w = line(p, ["town", "forest", "school"]);
+    w.economy.setTakesAll(w.at("school").id, true);
+    w.run(20);
+    expect(w.delivered()).toBe(9);
+    expect(w.told.has("Dropping planks here: the wagons are needed for logs before the school")).toBe(true);
+    expect(w.told.has("Keeping planks for the school: it's set to Research first")).toBe(false);
+  });
+
+  it("a routed line the same", () => {
+    const p = lackingPlanks();
+    const w = line(p, ["town", "forest", "school"]);
+    w.economy.setTakesAll(w.at("school").id, true);
+    w.route([{ stop: w.at("town") }, { stop: w.at("forest") }, { stop: w.at("school") }]);
+    w.run(20);
+    expect(w.delivered()).toBe(9);
+  });
+
+  it("the school before the forest: kept for the school as before", () => {
+    const p = lackingPlanks();
+    const w = line(p, ["town", "school", "forest"]);
+    w.economy.setTakesAll(w.at("school").id, true);
+    w.run(90);
+    expect(w.delivered()).toBe(0);
+    expect(p.research.got).toEqual({ planks: 9 });
+    const q = lackingPlanks();
+    const v = line(q, ["town", "school", "forest"]);
