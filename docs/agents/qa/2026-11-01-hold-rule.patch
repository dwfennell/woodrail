+      gives.push(g);
     }
     const at: Later[] = [];
     for (let i = 0; i < n; i++) {
-      const later: Later = { takes: 0, uses: 0, shop: 0, school: 0, town: false, towns: 0 };
+      const later: Later = { takes: 0, uses: 0, shop: 0, school: 0, town: false, towns: 0, loads: 0 };
       /** Goods some later stop other than a town's or a workshop's takes, so far round the line. */
       let taken = 0;
+      /** A school set to Research first has come round the line (the loads past it don't count). */
+      let schooled = false;
       for (let k = 1; k < n; k++) {
         const j = (i + k) % n;
         if (stops[j].depotId === stops[i].depotId) continue;
         const role = this.depots[stops[j].depotId]?.role;
+        if (role === "school" && this.depots[stops[j].depotId].takesAll) schooled = true;
+        if (!schooled) later.loads |= gives[j];
         later.takes |= takes[j];
         if (role && !RECIPES[role].routedOnly) later.uses |= takes[j];
         if (role === "workshop") later.shop |= takes[j];
